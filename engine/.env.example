# Copy this file to engine/.env and fill in real values.
# engine/.env is gitignored - never commit real secrets.

# Required: API key for your AI provider (see engine/ai.py - swappable).
AI_API=

# Required for production: protects developer/agent-facing endpoints
# (/support/queue, /clusters/{id}/resolve, /setup/webhook) behind an
# X-API-Key header. If unset, a random key is generated on every
# server start and printed to the console - fine for a quick local
# demo, not fine for anything left running unattended.
TACKETY_API_KEY=
